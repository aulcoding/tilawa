{
  "name": "tilawa",
  "private": true,
  "description": "Tilawa: a 29-day Qur'an reading plan, split by surah",
  "scripts": {
    "dev": "node dev.js",
    "build:css": "tailwindcss -i styles/app.css -o styles/build.css --minify",
    "build:wasm": "wasm-pack build crates/tilawa-app --target web --release --out-dir ../../pkg --no-pack",
    "build": "npm run build:wasm && npm run build:css",
    "test": "cargo test"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "tailwindcss": "4.3.5"
  }
}
