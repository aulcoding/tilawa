// Tilawa: English copy (follows the meaning and tone of id.jsonc).
// Edit the text between the quotes. Keep HTML tags like <span>, <em> and <a ...> in place.
// Need a double quote inside a text? Write \" or use curly quotes “ ”.
// Don't rename the keys (left of the colon). JSON plus // comments; a trailing comma is fine.
// Save and reload the page, no rebuild needed.

{
  // Browser tab
  "title": "Tilawa · 29 days to khatam",
  "langLabel": "Ganti ke Bahasa Indonesia", // screen-reader label for the EN/ID button
  "themeToDark": "Switch to dark mode",   // moon/sun button
  "themeToLight": "Switch to light mode",

  // Navigation
  "skip": "Skip to the schedule",
  "navSchedule": "Schedule",
  "navExcuses": "Excuses",
  "navSupport": "Support",
  "navStart": "Start Day 1",

  // Hero
  "breathIn": "Breathe in",
  "breathOut": "Breathe out",
  "moreOpen": "See why this plan makes sense", // chevron under the hero (screen readers + tooltip)
  "moreClose": "Hide",
  "moonLabel": "Tap the moon to bring it closer to full", // screen-reader label for the hero moon
  "kicker":
    "A Qur’an reading trigger for Muslims who are always stressed and f-ed up",
  "h1": "<span>It’s not that you have no time.</span> <span>You just don’t see it yet.</span>",
  "heroSub":
    "Work burns you out. Scrolling rots your brain. And your escape still isn’t the Qur’an? Sad.",
  "ctaPlan": "Okay. Show me the rules",
  "laterA": "I’ll start tomorrow", // button label
  "laterB": "Sure. Like yesterday.", // label shown on hover / tap

  // Big stats line (each <span> is one line on phones)
  "stats":
    "<span>29 days.</span> <span>114 surahs.</span> <span>Fewer “buts.”</span>",

  // Screen time section
  "realityH": "Let’s check where your time actually goes.",
  "realityP":
    "Every morning, WhatsApp gets checked right on time and the reels never stop. Outside work, the phone never leaves your hand. But 45 minutes with the Qur’an? “No time. I’m busy.” Well, maybe that’s why you’re <em>losing it</em>.",
  "ayah": "“Verily, in the remembrance of Allah do hearts find rest.”",
  "ayahNote":
    "Check the translation on <a href=\"#schedule\" data-jump=\"9\">Day 9</a>. Spoiler.",

  // Plan section
  "planH": "Read by surah, not by juz.",
  "planLede":
    "No more forgetting which page you stopped on. Every day ends at the end of a surah, and it just feels different.",
  "r1h": "Day one. Big match.",
  "r1p": "Al-Fatihah plus all of Al-Baqarah. Front-loaded on purpose. A test of nerve.",
  "r1s": "Day 1 · 49 pages",   // small key number at the bottom of the card
  "r2h": "They’re besties.",
  "r2p": "Al-Anfal &amp; At-Taubah on Day 7, Al-Isra’ &amp; Al-Kahf on Day 11. They come as a pair.",
  "r2s": "Days 7 &amp; 11",
  "r3h": "Day 15: Al-Furqan.",
  "r3p": "It means the Criterion. Full moon.",
  "r3s": "Day 15 · 8 pages",
  "r4h": "Days 16–29 get lighter.",
  "r4p": "About 17 pages a day. Takes about as long as one TikTok scrolling session.",
  "r4s": "±17 pages / day",

  // Schedule section
  "schedH": "29 days. Cry your eyes out and read.",
  "schedLede": "Tap the card or + for every page you finish.",
  "note": "The moon keeps changing with every day you finish. Progress is saved in your browser.",
  "day": "Day", // label above the day number on each card
  "surah": "Surah ", // single surah, e.g. "Surah 3"
  "surahs": "Surahs ", // range, e.g. "Surahs 8–9"
  "done": "Done", // fallback if a day below is missing
  "pagesUnit": "pages",     // on the card: "12/49 pages"
  "pagesShort": "Pages",    // on the card: "Pages 1–49"
  "pagePlus": "Add one page",
  "pageMinus": "Remove one page",
  // Line inside a card, random on every tap: calming, with a (slightly sarcastic) nudge away from social media & notifications.
  // {left} = pages left that day.
  "cheer": [
    "Breathe. The notifications aren’t going anywhere.",
    "Put the phone down. It won’t sulk.",
    "Relax. The group chat survives without you.",
    "Reels won’t miss you. Keep going.",
    "Calm heart. Keep TikTok closed.",
    "Airplane mode: most underrated feature.",
    "The world’s still loud. It’s quiet here.",
    "Your timeline doesn’t need you right now.",
    "One more page, one less scroll.",
    "FOMO can wait. Peace first.",
    "{left} pages left. Their stories can wait.",
    "That red badge can be patient. So can you.",
    "Take it slow. Nobody’s liking this.",
    "Cheapest detox ever: free.",
    "The algorithm lost you. Good.",
    "{left} pages left. The world will be fine.",
  ],
  // Label shown on a card once that day is ticked. Day 1 stays serious.
  "doneDays": [
    "Alhamdulillah. Done.", // Day 1
    "Wait, you’re really going on?", // Day 2
    "Consistent? That’s new.", // Day 3
    "Who even are you?", // Day 4
    "The work chat lost.", // Day 5
    "Still alive, right?", // Day 6
    "One week. Brag a little.", // Day 7
    "Didn’t see that coming.", // Day 8
    "Heart at rest? Told you.", // Day 9
    "Double digits. Fancy.", // Day 10
    "Combo deal, done.", // Day 11
    "The couch lost. Badly.", // Day 12
    "Not a fluke anymore.", // Day 13
    "Almost halfway. Hold on.", // Day 14
    "Past the quitting zone.", // Day 15
    "Downhill now. Enjoy it.", // Day 16
    "So consistency is possible.", // Day 17
    "Notifications? Later.", // Day 18
    "Since when are you diligent?", // Day 19
    "Twenty. Seriously?", // Day 20
    "Three weeks. Scary.", // Day 21
    "Almost there. Stay humble.", // Day 22
    "Doomscrolling, retired.", // Day 23
    "Five left. Don’t wobble.", // Day 24
    "Short surahs, long spirit.", // Day 25
    "Three left. Focus.", // Day 26
    "Two left. Don’t relapse.", // Day 27
    "Final tomorrow. Sleep early.", // Day 28
    "Khatam. Who knew.", // Day 29
  ],
  "reset": "Reset progress",
  "resetArmed": "Tap again to reset all 29 days",
  "skipWarn": "Don’t skip this surah", // bubble on the day you tried to jump past
  "carouselOne": "Day {from} of 29",             // carousel position on phones
  "carouselMany": "Days {from}–{to} of 29",      // carousel position on tablet/desktop
  "carouselPrev": "Previous days",
  "carouselNext": "Next days",
  "undoLast": "Undo from the end: Day {n} first.", // unticking an earlier day; {n} = last done day
  "later": "Sure. Like yesterday.", // read aloud to screen readers when "I’ll start tomorrow" is tapped

  // Progress message: [0 days, 1–14 days, 15–28 days, all 29]
  "msg": [
    "Still at zero. Let’s go.",
    "Okay, we see the effort.",
    "Past halfway. Too late to skip now.",
    "Khatam. Alhamdulillah. Now do it again.",
  ],
  // While on Day 1 (big match): fully positive. Line next to the big progress number, changes when a day is finished.
  "progressDay1": [
    "The first step is always the hardest. You’ve started.",
    "Big match is on. Bismillah, keep going.",
    "Al-Baqarah is long. You’re stronger.",
    "Day one. Your intention is already good.",
    "Slow and steady. You’re on the right path.",
    "Every page counts. Keep it up.",
  ],
  // Day 2 onward: encouraging, with a little sarcasm.
  "progress": [
    "Wow, no TikTok yet. Proud of you.",
    "The group chat can wait. Really.",
    "Keep going. Reels won’t miss you.",
    "Look at you being diligent. Who knew.",
    "Notifications can wait their turn.",
    "Not a dream. You’re actually reading.",
    "The couch can wait. Keep going.",
    "Don’t get suddenly busy now.",
    "You’ve stayed up later for worse.",
    "Look at you, consistent. Weird, but good.",
  ],

  // Tags on special day cards
  "tags": {
    "boss": "Big match", // Day 1
    "pack": "Combo deal", // Day 7 and Day 11
    "half": "Halfway. Don’t stop here.", // Day 15
    "end": "Khatam. Go flex to your mom.", // Day 29
  },

  // Excuses section: q = the excuse, a = the comeback
  "excH": "These are your excuses, right?",
  "e1q": "I’m so stressed right now.",
  "e1a": "Uh, that’s exactly the point.",
  "e2q": "I’ve got a deadline.",
  "e2a": "Classic excuse.",
  "e3q": "I have an exam tomorrow.",
  "e3a": "Doesn’t reading the Qur’an clear your head?",
  "e4q": "Politics is driving me insane.",
  "e4a": "Musa had the same problem with Pharaoh. Open the Qur’an.",
  "e5q": "I missed a day.",
  "e5a": "Make it up the next day. Discipline brings calm.",
  "e6q": "Day 1 is too long.",
  "e6a": "Split Al-Baqarah over two days, then merge two lighter days at the end.",

  // Closing section
  "finalH": "Start today. Not Monday.",
  "finalLede": "Not after the sprint. Not after finals. Not after the elections.",
  "finalCta": "Okay, okay. Day 1.",
  "finalMicro": "45 minutes. You’ve wasted more on things that matter less.",
  "shareCta": "Invite a friend", // copy-link button
  "shareDone": "Copied",
  "shareFail": "Couldn’t copy. Copy it from the address bar.",

  // Support section (Saweria)
  "supportH": "Help keep the moon lit.",
  "supportP": "This site is free. No monthly fees, no ads. It’ll stay that way.",
  "supportCta": "Support on Saweria",
  "supportNote": "Scan the QR or tap the button.",

  // Footer
  "footer": "Built for tired procrastinators. Relax—I’m just like you.",
